# ==============================================================================
# DoOps Web 控制台环境变量模板（Next.js BFF）
# ==============================================================================
# 本地开发：复制为 .env.local（已被 .gitignore 忽略，严禁提交真实密钥）
# 生产部署：通过容器 env 或 backend/scripts/deploy-web-console.sh 注入
# 完整权威说明见：backend/docs/CONFIGURATION.md
# ==============================================================================

# [生产环境必填] 控制台服务端代理允许访问的 Gateway origin 白名单（逗号分隔，不含路径）。
# - 开发模式（NODE_ENV!=production）留空时自动仅放行本机回环（localhost / 127.0.0.1）；
# - 生产模式（NODE_ENV=production）留空将 fail-closed 返回 403，且非回环目标必须使用 https://。
DOOPS_CONSOLE_ALLOWED_GATEWAYS=https://gateway.example.com

# [反代终止 TLS 且改写 Host/协议时必填] 浏览器访问控制台的对外 origin（小写 https，不含路径），
# 用于同源 CSRF 校验。直连且 Host 与对外一致时可留空。
# DOOPS_CONSOLE_ORIGIN=https://doops.example.com

# [反代登录限流时配置] 浏览器到 Next.js 之间的可信反向代理层数（1..16，0=禁用）：
# 例如单层 Nginx 反代填 1，CDN + Nginx 两层填 2。
# DOOPS_CONSOLE_TRUSTED_PROXY_HOPS=1

# [反代登录限流时配置] 与 Gateway 侧 DOOPS_CONSOLE_FORWARD_SECRET 完全一致的高熵随机密钥，
# 用于签名 X-DoOps-Client-IP，防止所有控制台用户共享同一个登录限流桶。
# DOOPS_CONSOLE_FORWARD_SECRET=replace-with-shared-hmac-secret

# [可选，构建期变量] 设为 1 可在生产构建中允许进入无后端只读演示模式；默认生产关闭、开发允许。
# NEXT_PUBLIC_DOOPS_DEMO=0

# Next.js 监听配置（Dockerfile.web 默认已设为 0.0.0.0 / 3000 / production）
# HOSTNAME=0.0.0.0
# PORT=3000
