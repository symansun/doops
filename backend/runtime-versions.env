# Image sources are operator inputs and are never pinned to a registry here:
#   export DO_AGENT_IMAGE=<registry>/<repository>@sha256:<DO_AGENT_INDEX_DIGEST>
#   export DOOPS_AGENT_BASE_IMAGE=<registry>/<repository>@sha256:<digest>
# The build scripts fail closed when either is missing, and DO_AGENT_IMAGE must
# be pinned to DO_AGENT_INDEX_DIGEST.
