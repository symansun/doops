# ==============================================================================
# DoOps Gateway 控制面环境配置模板 (/etc/doops-gateway.env)
# ==============================================================================
# 使用方式：
#   1. 复制到 Gateway 宿主机 /etc/doops-gateway.env，权限必须设为 0600（仅 root 可读）：
#        sudo install -m 0600 doops-gateway.env.example /etc/doops-gateway.env
#   2. 在 systemd 单元中通过 EnvironmentFile=/etc/doops-gateway.env 加载
#      （参考 backend/deploy/systemd/doops-gateway.service.example）。
#   3. 所有配置仅在进程启动时读取，修改后执行：sudo systemctl restart doops-gateway
#   4. 严禁将填有真实密钥/DSN 的文件提交到 Git 仓库。
#
# 完整权威说明见：backend/docs/CONFIGURATION.md 与 backend/docs/RUNTIME_LIMITS.md
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. 受管凭据加密主密钥（启用凭据管理/自定义 MCP 敏感头/模型下发时必填）
# ------------------------------------------------------------------------------
# 生成方式：python3 -c 'import secrets; print(secrets.token_hex(32))'
# 必须独立备份；若库中已存在密文且该密钥缺失或不匹配，Gateway 启动会直接失败。
DOOPS_GATEWAY_SECRET_KEY=replace-with-64-hex-chars-generated-via-secrets-token-hex-32

# [仅主密钥轮换过渡期] 旧主密钥；执行 `doops-gateway secret-key rotate` 完成后务必删除。
# DOOPS_GATEWAY_SECRET_KEY_PREVIOUS=


# ------------------------------------------------------------------------------
# 2. 控制面存储后端与数据目录
# ------------------------------------------------------------------------------
# 存储引擎：sqlite（默认，零配置，数据库路径由 -db 指定）| mysql（生产 MySQL 5.7/8.0/8.4）
# 非法值启动直接失败，绝不静默回退。
DOOPS_GATEWAY_STORE=sqlite

# [DOOPS_GATEWAY_STORE=mysql 时必填] MySQL DSN（必须带 parseTime=true）
# 注意：使用 MySQL 时，在宿主机手工运行 doops-gateway enroll/user/audit/store 子命令前
# 必须先执行 `set -a; source /etc/doops-gateway.env; set +a`。
# DOOPS_GATEWAY_MYSQL_DSN=doops_user:replace-password@tcp(db.example.com:3306)/doops?parseTime=true

# [仅 DOOPS_GATEWAY_STORE=mysql 时生效] 宿主机文件根目录（绝对路径），存放 skills/、artifacts/、audit/。
# 默认：/var/lib/doops-gateway；相对路径或不可写目录将导致启动失败。
# DOOPS_GATEWAY_DATA_DIR=/var/lib/doops-gateway

# 审计大正文存储模式：
#   db   — 默认，所有审计记录与输出尾部内联存数据库
#   file — File-First 文档存储（正文落盘 <dataDir>/audit/{docs,records}/，热库仅存轻量指针）
# DOOPS_AUDIT_STORAGE=file


# ------------------------------------------------------------------------------
# 3. Agent 注册认证与凭据下发策略
# ------------------------------------------------------------------------------
# 默认策略（以下两项均不设置或设为 0）：
#   - 尚未确认过 enrollment token 的新 target 免密钥即可连入，并可正常接收模型与受管凭据；
#   - 已通过 `doops-gateway enroll create` 绑定并确认过的 target 仍强制校验其专属密钥。
#
# 需要强制所有 Agent（含全新节点）都必须携带注册密钥才能连入时，取消注释并设为 1：
# DOOPS_REQUIRE_AGENT_ENROLLMENT=1
#
# 若保持开放注册，但希望禁止向未绑定注册密钥的 Agent 下发/物化凭据（返回 409），设为 1：
# DOOPS_REQUIRE_ENROLLED_CREDENTIAL_DELIVERY=1
#
# 说明：旧变量 DOOPS_ALLOW_OPEN_AGENT_REGISTRATION / DOOPS_ALLOW_UNENROLLED_CREDENTIAL_DELIVERY
# 仍向后兼容，新配置请统一使用上面的 DOOPS_REQUIRE_* 开关。


# ------------------------------------------------------------------------------
# 4. 对象存储 COS / S3 兼容（用于工作区 push/pull 快照及 audit export / store backup）
# ------------------------------------------------------------------------------
# 五项须成套填写；不需要快照与远程归档时可保持注释。
# DOOPS_COS_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
# DOOPS_COS_REGION=ap-shanghai
# DOOPS_COS_BUCKET=doops-artifacts-example
# DOOPS_COS_ACCESS_KEY_ID=replace-with-cos-access-key-id
# DOOPS_COS_SECRET_ACCESS_KEY=replace-with-cos-secret-access-key


# ------------------------------------------------------------------------------
# 5. Web 控制台反代联动与 WebSocket Origin 安全
# ------------------------------------------------------------------------------
# 与 Web 控制台侧完全一致的高熵共享密钥，用于验签浏览器真实 IP 登录限流头。
# 未配置时按直接对端 IP 限流。
# DOOPS_CONSOLE_FORWARD_SECRET=replace-with-shared-hmac-secret

# 浏览器访问 Gateway WebSocket 的额外允许来源（逗号分隔）；留空默认仅放行同 Host 同端口。
# DOOPS_ALLOWED_WS_ORIGINS=https://doops.example.com

# [仅本地调试] 设为 1 放行任意 WebSocket Origin；生产环境严禁开启。
# DOOPS_ALLOW_ALL_WS_ORIGINS=0


# ------------------------------------------------------------------------------
# 6. 巡检产物、指标、离线实例与资源同步留存策略
# ------------------------------------------------------------------------------
# 巡检产物保留天数（默认 30）
# DOOPS_MONITOR_ARTIFACT_RETENTION_DAYS=30
# 巡检时序指标保留天数（默认 90）
# DOOPS_MONITOR_METRIC_RETENTION_DAYS=90
# 每个定时巡检计划至少保留的最近运行次数（默认 50）
# DOOPS_MONITOR_ARTIFACT_KEEP_RUNS=50
# 离线实例在 agent_status 中的保留时长（默认 336h 即 14 天，支持 1s..8760h）
# DOOPS_OFFLINE_INSTANCE_RETENTION=336h
# 平台负载采样保留时长（默认 720h 即 30 天）
# DOOPS_PLATFORM_LOAD_SAMPLE_RETENTION=720h
# 目标资源同步连续缺失判定阈值（默认 3，范围 1..10000）
# DOOPS_AGENT_RESOURCE_MISS_THRESHOLD=3


# ------------------------------------------------------------------------------
# 7. 运行时超时与高级调优（默认均已校准，非法值会导致启动失败）
# ------------------------------------------------------------------------------
# 完整超时变量表、范围与不等式校验见 backend/docs/RUNTIME_LIMITS.md
# DOOPS_AGENT_LEASE=90s
# DOOPS_AGENT_HEARTBEAT_FLUSH=30s
# DOOPS_OPERATION_TIMEOUT=60m
# DOOPS_DETACHED_TASK_TIMEOUT=24h
# DOOPS_TARGET_QUEUE_TIMEOUT=10m
# DOOPS_TARGET_RECONNECT_GRACE=10s
# DOOPS_SHUTDOWN_DRAIN_TIMEOUT=2m
# DOOPS_HTTP_SHUTDOWN_TIMEOUT=10s
# DOOPS_HTTP_READ_HEADER_TIMEOUT=10s
# DOOPS_HTTP_IDLE_TIMEOUT=2m
# DOOPS_EXECUTION_RESUME_GRACE=60s
# DOOPS_EXECUTION_RESUME_WAIT_MAX=5s
# DOOPS_EXECUTION_RESUME_TTL=30m
# DOOPS_CREDENTIAL_DELIVERY_TIMEOUT=3m
# DOOPS_MYSQL_CONNECT_TIMEOUT=8s
# DOOPS_MONITOR_TICK=15s
# DOOPS_MONITOR_RETENTION_MIN_INTERVAL=15m
# DOOPS_AUDIT_RETENTION_INTERVAL=6h
# DOOPS_EXPIRED_TOKEN_SWEEP_INTERVAL=6h
# DOOPS_OFFLINE_REAPER_INTERVAL=1h
# DOOPS_AUDIT_PURGE_BATCH_PAUSE=100ms
# DOOPS_MAX_WS_MESSAGE_BYTES=33554432

# [仅挂载只读宿主诊断目录时使用]
# DOOPS_MACHINE_DIAGNOSTICS_ROOT=

# [仅启用 -edge-listen 时生效的 Edge 隧道参数，详见 backend/docs/design/DOOPS_EDGE_TUNNEL.md]
# DOOPS_EDGE_FRAME_BYTES=32768
# DOOPS_EDGE_HELLO_BYTES=4096
# DOOPS_EDGE_CONN_QUEUE=8
# DOOPS_EDGE_QUANTUM=2
# DOOPS_EDGE_MEM_BUDGET=536870912
# DOOPS_EDGE_MAX_CONNS=4096
# DOOPS_EDGE_MAX_CONNS_PER_IP=64
# DOOPS_EDGE_WRITE_STALL=30s
# DOOPS_EDGE_CONN_ID_QUARANTINE=30s
# DOOPS_EDGE_HELLO_TIMEOUT=5s
