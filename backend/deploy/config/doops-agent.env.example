# ==============================================================================
# DoOps Agent 节点环境配置模板（独立 Docker / 宿主机部署）
# ==============================================================================
# 使用方式：
#   - 独立 Docker（compose env_file）：chmod 0600 /opt/doops-agent/enrollment.env
#   - Kubernetes 集群部署请使用 Helm values.yaml + Secret（不要把明文写入 Git），
#     详见 backend/deploy/helm/doops-agent/values.yaml。
#   - 完整变量说明见：backend/docs/CONFIGURATION.md 与 backend/docs/RUNTIME_LIMITS.md
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Gateway 隧道身份与可选注册密钥
# ------------------------------------------------------------------------------
# 容器模板入口（Helm / entrypoint）读取以下三项并透传给 -gateway-url / -cluster / -instance；
# 直接运行裸二进制 doops-agent 时请通过命令行参数显式传入。
DOOPS_GATEWAY_URL=https://gateway.example.com
DOOPS_GATEWAY_CLUSTER=prod-cluster
DOOPS_GATEWAY_INSTANCE=node-01

# [可选；Gateway 开启 DOOPS_REQUIRE_AGENT_ENROLLMENT=1 或该 target 已锁定密钥时必填]
# 由 Gateway 宿主机 `doops-gateway enroll create -cluster <c> -instance <i>` 签发。
# 必须通过 0600 环境文件或 K8s secretKeyRef 注入，禁止写入命令行参数 -enroll-token。
# DOOPS_AGENT_ENROLL_TOKEN=dga_aen_aen_replace_with_issued_token

# [仅内网/开发调试] 设为 1 允许连接非回环明文 http:// / ws:// Gateway；生产环境禁开。
# DOOPS_ALLOW_INSECURE_GATEWAY=0

# [仅容器入口使用] Kubernetes 凭据来源：mounted（默认，挂载 /root/.kube/config）| serviceAccount
# DOOPS_KUBECONFIG_SOURCE=mounted


# ------------------------------------------------------------------------------
# 2. 公网代理白名单与命令双层过滤
# ------------------------------------------------------------------------------
# 公网网站代理允许访问的上游主机名白名单（逗号分隔）；默认空值拒绝全部代理出站。
# DOOPS_PROXY_ALLOW_HOSTS=127.0.0.1,internal.example.com

# 额外结构化 argv AST 拒绝策略 YAML 文件路径（fail-closed，见 backend/docs/design/COMMAND_FILTER.md）
# DOOPS_COMMAND_POLICY_FILE=/etc/doops/command-policy.yaml

# 额外正则兜底拒绝规则 JSON 数组（fail-closed）：[{"name":"...","match":"...","hint":"..."}]
# DOOPS_COMMAND_DENY_RULES=[]


# ------------------------------------------------------------------------------
# 3. 持久化目录与 DoSql 状态
# ------------------------------------------------------------------------------
# 会话工作区根目录（默认 /root/ws）
# DOOPS_WORKSPACE_ROOT=/root/ws
# 知识库根目录（默认 /root/kb，必须绝对路径）
# DOOPS_KB_ROOT=/root/kb
# 平台同步 Skill 落盘根目录（默认 /root/.agent/skills）
# DOOPS_AGENT_SKILLS_ROOT=/root/.agent/skills
# DoSql 统一持久化目录（生产建议挂独立 PVC，保存版本链、历史、快照与外置驱动；必须绝对路径）
# DOOPS_DOSQL_STATE_DIR=/var/lib/doops-dosql
# 单独覆盖 DoSql 外置驱动目录（默认位于 DOOPS_DOSQL_STATE_DIR/drivers）
# DOOPS_DOSQL_DRIVER_DIR=/var/lib/doops-dosql/drivers
# 宿主机只读定时采样样本挂载目录（配套 doops-host-sample.service 使用）
# DOOPS_AGENT_MACHINE_DIAGNOSTICS_ROOT=/var/lib/doops-host-samples


# ------------------------------------------------------------------------------
# 4. 体积上限、AI 引擎与超时调优
# ------------------------------------------------------------------------------
# 内部 doagent ACP HTTP 地址与端口（默认 9000 / http://127.0.0.1:9000，仅监听回环）
# DO_AGENT_PORT=9000
# DO_AGENT_URL=http://127.0.0.1:9000

# 传输与文件体积上限（字节）
# DOOPS_MAX_WORKSPACE_UPLOAD_BYTES=536870912
# DOOPS_MAX_FILE_READ_BYTES=1048576
# DOOPS_MAX_FILE_WRITE_BYTES=16777216
# DOOPS_WORKSPACE_PULL_CHUNK_BYTES=524288
# DOOPS_MAX_WS_MESSAGE_BYTES=33554432

# Agent 侧超时覆盖（启动即校验，非法值直接退出；完整列表见 backend/docs/RUNTIME_LIMITS.md）
# DOOPS_TOOL_TIMEOUT=30m
# DOOPS_COMPLETED_TASK_MAX_AGE=24h
# DOOPS_TOOL_DEADLINE_MARGIN=5s
# DOOPS_HELM_SETTLE_RESERVE=90s
# DOOPS_HELM_SETTLE_TIMEOUT=45s
# DOOPS_HELM_MAX_WAIT=25m
# DOOPS_TUNNEL_READ_TIMEOUT=90s
# DOOPS_AGENT_EXECUTION_TTL=30m
# DOOPS_MCP_PROBE_TIMEOUT=12s
# DOOPS_EDGE_DIAL_TIMEOUT=5s
# DOOPS_EDGE_WS_READ_TIMEOUT=20s
