{
  "name": "@agent-cloud/agent-ui",
  "version": "0.1.4",
  "description": "React conversation components and a typed Agent Cloud session runtime.",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./index.js"
    },
    "./protocol": {
      "types": "./types/protocol/index.d.ts",
      "import": "./protocol.js"
    },
    "./runtime": {
      "types": "./types/runtime/index.d.ts",
      "import": "./runtime.js"
    },
    "./server": {
      "types": "./types/server/index.d.ts",
      "import": "./server.js"
    },
    "./worker": {
      "types": "./types/worker/index.d.ts",
      "import": "./worker.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "*.js",
    "*.css",
    "chunks",
    "types",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-web": "2.1.2",
    "@tanstack/react-virtual": "^3.13.23",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "6.1.200",
    "mermaid": "^11.12.0"
  },
  "peerDependencies": {
    "@xterm/addon-fit": "*",
    "@xterm/xterm": "*",
    "lucide-react": "*",
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20",
    "react-markdown": "*",
    "remark-gfm": "*"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/symansun/doops.git",
    "directory": "vendor/agent-ui"
  }
}
